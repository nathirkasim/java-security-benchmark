{
  "model_details": {
    "name": "enterprise-code-assistant-model",
    "version": "1.0.0",
    "format": "safetensors",
    "license": "Apache-2.0",
    "intended_use": "Assisting developer workflows through context-aware completion",
    "base_model": "mistralai/Mistral-7B-v0.1"
  },
  "training_data": {
    "dataset": "permissive-oss-code-v2",
    "license_scrubbed": true,
    "pii_filtered": true
  },
  "safety_guardrails": {
    "input_sanitizer": "XmlTagEnclosureWithRegexFilter",
    "max_context_tokens": 8192,
    "temperature": 0.2
  }
}
