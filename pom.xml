<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.benchmark.falsepositives</groupId>
    <artifactId>java-security-benchmark</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Java Security False Positive Benchmark</name>
    <description>
        Specialized benchmark suite designed to test SCA, SAST, IaC, Secrets, SBOM, CBOM, and AIBOM
        scanners (SonarQube, Wiz, Snyk, Semgrep, Trivy, Gitleaks, etc.) against false positive resilience.
    </description>

    <properties>
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <cyclonedx.version>2.7.9</cyclonedx.version>
    </properties>

    <dependencies>
        <!-- ============================================================== -->
        <!-- SCA Trap 1: Test-Scope Dependency with Known CVE              -->
        <!-- Naive scanners flag test-scoped dependencies as production risks -->
        <!-- ============================================================== -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.12</version>
            <scope>test</scope>
        </dependency>

        <!-- ============================================================== -->
        <!-- SCA Trap 2: Provided Scope (Container-provided runtime)        -->
        <!-- Never packaged into the distributable JAR/WAR artifact        -->
        <!-- ============================================================== -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- ============================================================== -->
        <!-- SCA Trap 3: Explicit Exclusion of Vulnerable Transitive Dep   -->
        <!-- Naive scanners flag the parent artifact without parsing exclusions -->
        <!-- ============================================================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-logging</artifactId>
            <version>2.7.0</version>
            <exclusions>
                <exclusion>
                    <groupId>org.apache.logging.log4j</groupId>
                    <artifactId>log4j-to-slf4j</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- ============================================================== -->
        <!-- SCA Trap 4: Optional Annotation Processor (Compile-time only) -->
        <!-- Stripped at bytecode compile time; not present in runtime     -->
        <!-- ============================================================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>1.18.24</version>
            <scope>provided</scope>
            <optional>true</optional>
        </dependency>

        <!-- ============================================================== -->
        <!-- Production Dependencies (Secure Versions for Reference)       -->
        <!-- ============================================================== -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>32.1.3-jre</version>
        </dependency>
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.14.0</version>
        </dependency>
        <dependency>
            <groupId>org.owasp.encoder</groupId>
            <artifactId>encoder</artifactId>
            <version>1.2.3</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- CycloneDX SBOM Generator Plugin -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>makeAggregateBom</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
